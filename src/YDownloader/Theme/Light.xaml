<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Flächen -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E5E5EA"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#6E6E73"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#7C7C82"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#AEAEB2"/>

    <!-- Akzent und Zustände -->
    <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#0077EE"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1F0A84FF"/>
    <SolidColorBrush x:Key="Success" Color="#28C840"/>
    <SolidColorBrush x:Key="Warning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="Error" Color="#FF3B30"/>
    <!-- Dunklere Töne für Text; Warning und Error bleiben für Punkte und Balken -->
    <SolidColorBrush x:Key="TextWarning" Color="#B45309"/>
    <SolidColorBrush x:Key="TextSuccess" Color="#1A7F37"/>
    <SolidColorBrush x:Key="TextError" Color="#C5000F"/>

    <!-- Liste -->
    <SolidColorBrush x:Key="RowHover" Color="#08000000"/>
    <SolidColorBrush x:Key="RowSelected" Color="#260A84FF"/>
    <SolidColorBrush x:Key="RowSelectedInactive" Color="#1F000000"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#EFEFF4"/>
    <SolidColorBrush x:Key="BadgeText" Color="#6E6E73"/>
    <SolidColorBrush x:Key="BarTrack" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="BarPaused" Color="#AEAEB2"/>

    <!-- Bedienelemente -->
    <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#D1D1D6"/>
    <SolidColorBrush x:Key="ControlHover" Color="#0F000000"/>
    <SolidColorBrush x:Key="ControlPressed" Color="#1F000000"/>
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusRing" Color="#CC0A84FF"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#40000000"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#73000000"/>

    <!-- Menüs, Sheets -->
    <SolidColorBrush x:Key="MenuBackground" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="SheetBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Backdrop" Color="#26000000"/>
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Graph -->
    <SolidColorBrush x:Key="GraphStroke" Color="#0A84FF"/>
    <SolidColorBrush x:Key="GraphFill" Color="#330A84FF"/>

    <!-- Ampel -->
    <SolidColorBrush x:Key="LightClose" Color="#FF5F57"/>
    <SolidColorBrush x:Key="LightMinimize" Color="#FEBC2E"/>
    <SolidColorBrush x:Key="LightZoom" Color="#28C840"/>
    <SolidColorBrush x:Key="LightInactive" Color="#CECECE"/>
    <SolidColorBrush x:Key="LightGlyphClose" Color="#B34D0000"/>
    <SolidColorBrush x:Key="LightGlyphMinimize" Color="#B3995700"/>
    <SolidColorBrush x:Key="LightGlyphZoom" Color="#B3006500"/>
    <SolidColorBrush x:Key="LightPressed" Color="#33000000"/>
</ResourceDictionary>
