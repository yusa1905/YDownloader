<Window x:Class="YDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:YDownloader"
        xmlns:c="clr-namespace:YDownloader.Controls"
        xmlns:d="clr-namespace:YDownloader.Downloads"
        Title="YDownloader" Width="960" Height="600"
        MinWidth="{DynamicResource WindowMinWidth}" MinHeight="{DynamicResource WindowMinHeight}"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="False"
        FontFamily="{DynamicResource FontUi}" FontSize="{DynamicResource FontSizeBody}"
        Foreground="{DynamicResource TextPrimary}"
        AllowDrop="True" DragEnter="Window_DragOver" DragOver="Window_DragOver" DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Ein Ampel-Knopf: Kreis, Symbol erscheint beim Überfahren der ganzen Ampel. -->
        <Style x:Key="TrafficLight" TargetType="Button">
            <Setter Property="Width" Value="{DynamicResource LightSize}"/>
            <Setter Property="Height" Value="{DynamicResource LightSize}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Dot" Fill="{TemplateBinding local:Light.Fill}"/>
                            <Path Data="{TemplateBinding local:Light.Glyph}"
                                  Stroke="{TemplateBinding local:Light.GlyphBrush}" StrokeThickness="{DynamicResource LightGlyphStroke}"
                                  Width="{DynamicResource LightGlyphSize}" Height="{DynamicResource LightGlyphSize}"
                                  Stretch="None" Visibility="{TemplateBinding local:Light.GlyphVisibility}"
                                  StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" SnapsToDevicePixels="True" IsHitTestVisible="False"/>
                            <Path Data="{TemplateBinding local:Light.GlyphFill}"
                                  Fill="{TemplateBinding local:Light.GlyphBrush}"
                                  Width="{DynamicResource LightGlyphSize}" Height="{DynamicResource LightGlyphSize}"
                                  Stretch="None" Visibility="{TemplateBinding local:Light.GlyphVisibility}"
                                  SnapsToDevicePixels="True" IsHitTestVisible="False"/>
                            <Ellipse x:Name="Press" Fill="{DynamicResource LightPressed}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Press" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eine Zeile der Download-Liste -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type d:DownloadItem}">
          <Grid x:Name="Root">
            <!-- Kompakt: fertige Downloads -->
            <Grid x:Name="Compact" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource BadgeColumn}"/>
                    <ColumnDefinition Width="{DynamicResource RowGap}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{DynamicResource CompactSizeColumn}"/>
                    <ColumnDefinition Width="{DynamicResource CompactTimeColumn}"/>
                    <ColumnDefinition Width="{DynamicResource CompactStateColumn}"/>
                    <ColumnDefinition Width="{DynamicResource RowButtonColumn}"/>
                </Grid.ColumnDefinitions>

                <Border Width="{DynamicResource BadgeWidth}" Height="{DynamicResource CompactBadgeHeight}"
                        CornerRadius="{DynamicResource BadgeCorner}" Background="{DynamicResource BadgeBackground}">
                    <TextBlock Text="{Binding Badge}" FontSize="{DynamicResource FontSizeBadge}" FontWeight="SemiBold"
                               Foreground="{DynamicResource BadgeText}" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Margin="{DynamicResource CompactBadgeTextMargin}"/>
                </Border>

                <DockPanel Grid.Column="2" VerticalAlignment="Center" LastChildFill="True">
                    <TextBlock x:Name="PackageTag" DockPanel.Dock="Right" Text="{Binding PackageTag}"
                               Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"
                               MaxWidth="{DynamicResource CompactPackageMaxWidth}" Margin="{DynamicResource CompactPackageMargin}"
                               ToolTip="{Binding PackageTag}"/>
                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                </DockPanel>

                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource SecondaryText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                <TextBlock Grid.Column="4" Text="{Binding DoneTimeText}" Style="{StaticResource SecondaryText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Typography.NumeralAlignment="Tabular"/>
                <TextBlock x:Name="CompactState" Grid.Column="5" Text="{Binding StateText}" Style="{StaticResource SecondaryText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StateText}" Margin="{DynamicResource CompactPackageMargin}"/>

                <Button Grid.Column="6" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        Width="{DynamicResource RowButtonSize}" Height="{DynamicResource RowButtonSize}"
                        Content="{DynamicResource IconFolder}" ToolTip="{local:Str Action.ShowInFolder}" Click="RowAction_Click"/>
            </Grid>

            <Grid x:Name="Large">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource BadgeColumn}"/>
                    <ColumnDefinition Width="{DynamicResource RowGap}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{DynamicResource RowGap}"/>
                    <ColumnDefinition Width="{DynamicResource SpeedColumn}"/>
                    <ColumnDefinition Width="{DynamicResource RowButtonColumn}"/>
                </Grid.ColumnDefinitions>

                <Border Width="{DynamicResource BadgeWidth}" Height="{DynamicResource BadgeHeight}"
                        CornerRadius="{DynamicResource BadgeCorner}" Background="{DynamicResource BadgeBackground}">
                    <TextBlock Text="{Binding Badge}" FontSize="{DynamicResource FontSizeBadge}" FontWeight="SemiBold"
                               Foreground="{DynamicResource BadgeText}" HorizontalAlignment="Center"
                               VerticalAlignment="Bottom" Margin="{DynamicResource BadgeTextMargin}"/>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                    <c:SegmentBar x:Name="Bar" Height="{DynamicResource BarHeight}" Margin="{DynamicResource BarMargin}"
                                  Progress="{Binding Progress}" Fraction="{Binding Fraction}"
                                  Fill="{DynamicResource Accent}" Track="{DynamicResource BarTrack}"/>
                    <TextBlock x:Name="Detail" Text="{Binding DetailText}" Style="{StaticResource SecondaryText}"
                               Typography.NumeralAlignment="Tabular"/>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SpeedText}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="{Binding EtaText}" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"
                               Typography.NumeralAlignment="Tabular" Margin="{DynamicResource EtaMargin}"/>
                </StackPanel>

                <Button x:Name="Action" Grid.Column="5" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        Width="{DynamicResource RowButtonSize}" Height="{DynamicResource RowButtonSize}"
                        Content="{DynamicResource IconPause}" ToolTip="{local:Str Action.Pause}" Click="RowAction_Click"/>
            </Grid>
          </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPackagePart}" Value="True">
                    <Setter TargetName="Root" Property="Margin" Value="{DynamicResource PackagePartIndent}"/>
                    <Setter TargetName="PackageTag" Property="Visibility" Value="Collapsed"/> <!-- der Kopf darüber nennt das Paket -->

                </DataTrigger>
                <DataTrigger Binding="{Binding StateIsProblem}" Value="True">
                    <Setter TargetName="CompactState" Property="Foreground" Value="{DynamicResource TextWarning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PackageTag}" Value="">
                    <Setter TargetName="PackageTag" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding BarHidden}" Value="True">
                    <Setter TargetName="Bar" Property="Visibility" Value="Hidden"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static d:DownloadStatus.Paused}">
                    <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource BarPaused}"/>
                    <Setter TargetName="Action" Property="Content" Value="{DynamicResource IconPlay}"/>
                    <Setter TargetName="Action" Property="ToolTip" Value="{local:Str Action.Start}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static d:DownloadStatus.Queued}">
                    <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource BarPaused}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static d:DownloadStatus.Completed}">
                    <Setter TargetName="Large" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Compact" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Success}"/>
                    <Setter TargetName="Action" Property="Content" Value="{DynamicResource IconFolder}"/>
                    <Setter TargetName="Action" Property="ToolTip" Value="{local:Str Action.ShowInFolder}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static d:DownloadStatus.Failed}">
                    <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Error}"/>
                    <Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource TextError}"/>
                    <Setter TargetName="Action" Property="Content" Value="{DynamicResource IconRetry}"/>
                    <Setter TargetName="Action" Property="ToolTip" Value="{local:Str Action.Retry}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Kopfzeile eines Pakets: fasst die Teile zusammen, Zustand (Warnung, Fehler) steht auch zugeklappt da. -->
        <DataTemplate x:Key="HeadTemplate" DataType="{x:Type d:PackageHead}">
            <Grid>
                <!-- Kompakt: alle Teile fertig -->
                <Grid x:Name="Compact" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource PackageChevronColumn}"/>
                        <ColumnDefinition Width="{DynamicResource BadgeColumn}"/>
                        <ColumnDefinition Width="{DynamicResource RowGap}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="{DynamicResource RowButtonColumn}"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" Content="{DynamicResource IconChevronRight}" x:Name="CompactChevron"
                            HorizontalAlignment="Left" Width="{DynamicResource RowButtonSize}" Height="{DynamicResource RowButtonSize}"
                            Click="HeadToggle_Click"/>
                    <Border Grid.Column="1" Width="{DynamicResource BadgeWidth}" Height="{DynamicResource CompactBadgeHeight}"
                            CornerRadius="{DynamicResource BadgeCorner}" Background="{DynamicResource BadgeBackground}">
                        <TextBlock Text="{Binding Badge}" FontSize="{DynamicResource FontSizeBadge}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BadgeText}" HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom" Margin="{DynamicResource CompactBadgeTextMargin}"/>
                    </Border>
                    <TextBlock Grid.Column="3" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip="{Binding Name}"/>
                    <TextBlock Grid.Column="4" Text="{Binding DetailText}" Style="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" Margin="{DynamicResource CompactPackageMargin}"
                               Typography.NumeralAlignment="Tabular"/>
                    <TextBlock x:Name="CompactState" Grid.Column="5" Text="{Binding StateText}" Style="{StaticResource SecondaryText}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="{DynamicResource PackageStateMaxWidth}" ToolTip="{Binding StateText}"
                               Margin="{DynamicResource CompactPackageMargin}"/>
                    <Button Grid.Column="6" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                            Width="{DynamicResource RowButtonSize}" Height="{DynamicResource RowButtonSize}"
                            Content="{DynamicResource IconFolder}" ToolTip="{local:Str Action.ShowInFolder}" Click="HeadAction_Click"/>
                </Grid>

                <Grid x:Name="Large">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{DynamicResource PackageChevronColumn}"/>
                        <ColumnDefinition Width="{DynamicResource BadgeColumn}"/>
                        <ColumnDefinition Width="{DynamicResource RowGap}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{DynamicResource RowGap}"/>
                        <ColumnDefinition Width="{DynamicResource SpeedColumn}"/>
                        <ColumnDefinition Width="{DynamicResource RowButtonColumn}"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="Chevron" Style="{StaticResource IconButton}" Content="{DynamicResource IconChevronRight}"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Width="{DynamicResource RowButtonSize}" Height="{DynamicResource RowButtonSize}"
                            Click="HeadToggle_Click"/>
                    <Border Grid.Column="1" Width="{DynamicResource BadgeWidth}" Height="{DynamicResource BadgeHeight}"
                            CornerRadius="{DynamicResource BadgeCorner}" Background="{DynamicResource BadgeBackground}">
                        <TextBlock Text="{Binding Badge}" FontSize="{DynamicResource FontSizeBadge}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BadgeText}" HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom" Margin="{DynamicResource BadgeTextMargin}"/>
                    </Border>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <c:SegmentBar x:Name="Bar" Height="{DynamicResource BarHeight}" Margin="{DynamicResource BarMargin}"
                                      Fraction="{Binding Fraction}" Fill="{DynamicResource Accent}" Track="{DynamicResource BarTrack}"/>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource SecondaryText}"
                                       Typography.NumeralAlignment="Tabular"/>
                            <TextBlock x:Name="State" Text="{Binding StateText, StringFormat=' &#183; {0}'}" Style="{StaticResource SecondaryText}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding StateText}"/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SpeedText}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                        <TextBlock Text="{Binding EtaText}" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}"
                                   Typography.NumeralAlignment="Tabular" Margin="{DynamicResource EtaMargin}"/>
                    </StackPanel>

                    <Button x:Name="Action" Grid.Column="6" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                            Width="{DynamicResource RowButtonSize}" Height="{DynamicResource RowButtonSize}"
                            Content="{DynamicResource IconPause}" ToolTip="{local:Str Action.Pause}" Click="HeadAction_Click"/>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="Content" Value="{DynamicResource IconChevronDown}"/>
                    <Setter TargetName="CompactChevron" Property="Content" Value="{DynamicResource IconChevronDown}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static d:PackageTone.Warning}">
                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource TextWarning}"/>
                    <Setter TargetName="CompactState" Property="Foreground" Value="{DynamicResource TextWarning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static d:PackageTone.Error}">
                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource TextError}"/>
                    <Setter TargetName="CompactState" Property="Foreground" Value="{DynamicResource TextError}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateText}" Value="">
                    <Setter TargetName="State" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static d:DownloadStatus.Paused}">
                    <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource BarPaused}"/>
                    <Setter TargetName="Action" Property="Content" Value="{DynamicResource IconPlay}"/>
                    <Setter TargetName="Action" Property="ToolTip" Value="{local:Str Action.Start}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static d:DownloadStatus.Queued}">
                    <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource BarPaused}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static d:DownloadStatus.Completed}">
                    <Setter TargetName="Large" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Compact" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static d:DownloadStatus.Failed}">
                    <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Error}"/>
                    <Setter TargetName="Action" Property="Content" Value="{DynamicResource IconRetry}"/>
                    <Setter TargetName="Action" Property="ToolTip" Value="{local:Str Action.Retry}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <c:RowTemplateSelector x:Key="RowSelector" Download="{StaticResource RowTemplate}" Head="{StaticResource HeadTemplate}"/>

        <ContextMenu x:Key="RowMenu" Opened="RowMenu_Opened">
            <MenuItem Tag="start" Header="{local:Str Action.Start}" InputGestureText="{local:Str Key.Space}" Click="MenuStart_Click"/>
            <MenuItem Tag="pause" Header="{local:Str Action.Pause}" InputGestureText="{local:Str Key.Space}" Click="MenuPause_Click"/>
            <Separator Tag="startSeparator"/>
            <MenuItem Tag="open" Header="{local:Str Menu.OpenFile}" InputGestureText="{local:Str Key.Enter}" Click="MenuOpen_Click"/>
            <MenuItem Header="{local:Str Action.ShowInFolder}" Click="MenuShow_Click"/>
            <MenuItem Header="{local:Str Menu.CopyLink}" InputGestureText="{local:Str Key.CtrlC}" Click="MenuCopy_Click"/>
            <MenuItem Header="{local:Str Menu.ExportLinks}" Click="MenuExport_Click"/>
            <MenuItem Tag="extract" Header="{local:Str Menu.Extract}" Click="MenuExtract_Click"/>
            <MenuItem Tag="password" Header="{local:Str Menu.EnterPassword}" Click="MenuPassword_Click"/>
            <Separator/>
            <MenuItem Tag="details" Header="{local:Str Menu.Details}" InputGestureText="{local:Str Key.CtrlI}" Click="MenuDetails_Click"/>
            <MenuItem Header="{local:Str Menu.Edit}" InputGestureText="F2" Click="MenuEdit_Click"/>
            <MenuItem Tag="category" Header="{local:Str Menu.Category}"/>
            <MenuItem Tag="queue" Header="{local:Str Menu.Queue}"/>
            <MenuItem Tag="after" Header="{local:Str Menu.After}" Click="MenuAfter_Click"
                      ToolTip="{local:Str Menu.AfterTip}"/>
            <Separator/>
            <MenuItem Header="{local:Str Menu.Remove}" InputGestureText="{local:Str Key.Delete}" Click="MenuRemove_Click"/>
        </ContextMenu>

        <!-- Seitenleiste -->
        <DataTemplate x:Key="SidebarTemplate" DataType="{x:Type d:SidebarEntry}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource SidebarIconColumn}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Icon" Text="{Binding Icon}" FontFamily="{DynamicResource FontIcons}"
                           FontSize="{DynamicResource FontSizeIconSmall}" Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                <!-- Nur an Überschriften mit einem Bearbeiten-Sheet (Queues, Kategorien) -->
                <Button x:Name="EditButton" Grid.Column="2" Style="{StaticResource IconButton}" Visibility="Collapsed"
                        Content="{DynamicResource IconEdit}" FontSize="{DynamicResource FontSizeIconSmall}"
                        Width="{DynamicResource SidebarEditButtonSize}" Height="{DynamicResource SidebarEditButtonSize}"
                        VerticalAlignment="Bottom" ToolTip="{Binding EditTip}" Click="SidebarEdit_Click"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasEdit}" Value="True">
                    <Setter TargetName="EditButton" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Title" Property="Grid.Column" Value="0"/>
                    <Setter TargetName="Title" Property="Grid.ColumnSpan" Value="2"/>
                    <Setter TargetName="Title" Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                    <Setter TargetName="Title" Property="Margin" Value="{DynamicResource SidebarHeaderMargin}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{DynamicResource TitleBarHeight}"
                      ResizeBorderThickness="{DynamicResource ResizeBorder}"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid LayoutTransform="{DynamicResource UiScaleTransform}">
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource TitleBarRow}"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="{StaticResource StatusBarRow}"/>
            </Grid.RowDefinitions>

            <!-- Titelleiste mit Ampel und Werkzeugen -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBackground}"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="{DynamicResource SeparatorBottom}">
                <Grid>
                    <StackPanel x:Name="Lights" Orientation="Horizontal" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Margin="{DynamicResource LightsMargin}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                MouseEnter="Lights_MouseChanged" MouseLeave="Lights_MouseChanged">
                        <Button x:Name="BtnClose" Style="{StaticResource TrafficLight}" Click="Close_Click"/>
                        <Button x:Name="BtnMin" Style="{StaticResource TrafficLight}" Margin="{DynamicResource LightSpacing}" Click="Minimize_Click"/>
                        <Button x:Name="BtnZoom" Style="{StaticResource TrafficLight}" Margin="{DynamicResource LightSpacing}" Click="Zoom_Click"/>
                    </StackPanel>
                    <TextBlock Text="YDownloader" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource TextSecondary}"
                               IsHitTestVisible="False"/>
                    <StackPanel x:Name="Toolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="{DynamicResource ToolbarMargin}">
                        <Button Style="{StaticResource IconButton}" Content="{DynamicResource IconAdd}"
                                ToolTip="{local:Str Main.Tool.Add}" Click="Add_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="{DynamicResource IconPlay}" Margin="{DynamicResource ToolGroupGap}"
                                ToolTip="{local:Str Main.Tool.StartAll}" Click="StartAll_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="{DynamicResource IconPause}"
                                ToolTip="{local:Str Main.Tool.PauseAll}" Click="PauseAll_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="{DynamicResource IconClear}" Margin="{DynamicResource ToolGroupGap}"
                                ToolTip="{local:Str Main.Tool.RemoveCompleted}" Click="RemoveCompleted_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="{DynamicResource IconPower}" Margin="{DynamicResource ToolGroupGap}"
                                ToolTip="{local:Str Main.Tool.After}" Click="After_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="{DynamicResource IconSettings}"
                                ToolTip="{local:Str Main.Tool.Settings}" Margin="{DynamicResource ToolGroupGap}" Click="Settings_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="Main" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{DynamicResource SidebarColumn}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Seitenleiste: Ansichten nach Zustand und Kategorie -->
                <Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource SeparatorBrush}"
                        BorderThickness="{DynamicResource SeparatorRight}">
                    <ListBox x:Name="SidebarList" Style="{StaticResource DownloadList}" SelectionMode="Single"
                             Padding="{DynamicResource SidebarPadding}" ItemTemplate="{StaticResource SidebarTemplate}"
                             ItemContainerStyle="{StaticResource SidebarRow}" SelectionChanged="Sidebar_SelectionChanged"/>
                </Border>

                <!-- Liste -->
                <Grid Grid.Column="1">
                    <ListBox x:Name="List" Style="{StaticResource DownloadList}" SelectionMode="Extended"
                             ItemTemplateSelector="{StaticResource RowSelector}" ItemContainerStyle="{StaticResource MainListRow}"
                             ContextMenu="{StaticResource RowMenu}"
                             KeyDown="List_KeyDown" MouseDoubleClick="List_MouseDoubleClick"/>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock Text="{DynamicResource IconDownload}" FontFamily="{DynamicResource FontIcons}"
                                   FontSize="{DynamicResource FontSizeEmptyIcon}" Foreground="{DynamicResource TextTertiary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyTitle" Text="{local:Str Main.Empty.Title}" Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center" Margin="{DynamicResource GapTopL}"/>
                        <TextBlock x:Name="EmptyHint" Text="{local:Str Main.Empty.Hint}"
                                   Style="{StaticResource SecondaryText}" Foreground="{DynamicResource TextTertiary}"
                                   HorizontalAlignment="Center" Margin="{DynamicResource GapTop}"/>
                    </StackPanel>

                    <Border x:Name="DropHint" Margin="{DynamicResource DropHintMargin}" Background="{DynamicResource AccentSoft}"
                            BorderBrush="{DynamicResource Accent}" BorderThickness="{DynamicResource DropHintThickness}"
                            CornerRadius="{DynamicResource SheetCorner}" IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock Text="{local:Str Main.DropHint}" FontSize="{DynamicResource FontSizeTitle}"
                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- Statusleiste: freier Speicher am Zielordner, Restzeit, Verlauf, Gesamtgeschwindigkeit -->
            <Border Grid.Row="2" Background="{DynamicResource TitleBarBackground}"
                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="{DynamicResource SeparatorTop}"
                    Padding="{DynamicResource StatusBarPadding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Stats.FreeSpaceText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" ToolTip="{local:Str Main.Status.FreeTip}"/>
                    <!-- Nur sichtbar, wenn ein Plan für „Nach Abschluss“ besteht. Klick öffnet die Einstellung. -->
                    <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="{Binding AfterCompletion.StatusText}"
                            Visibility="{Binding AfterCompletion.IsArmed, Converter={StaticResource BoolToVisibility}}"
                            VerticalAlignment="Center" Margin="{DynamicResource GapRight}" Click="After_Click"
                            ToolTip="{local:Str Main.Status.AfterTip}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Stats.EtaText}" Style="{StaticResource SecondaryText}"
                               Width="{DynamicResource EtaTextWidth}" TextAlignment="Right" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" ToolTip="{local:Str Main.Status.EtaTip}"/>
                    <c:SpeedGraph Grid.Column="3" Width="{DynamicResource GraphWidth}" Height="{DynamicResource GraphHeight}"
                                  Margin="{DynamicResource GraphMargin}" VerticalAlignment="Center" History="{Binding Stats.History}"
                                  Stroke="{DynamicResource GraphStroke}" Fill="{DynamicResource GraphFill}"
                                  Baseline="{DynamicResource BarTrack}" StrokeThickness="{DynamicResource GraphStrokeThickness}"
                                  Headroom="{DynamicResource GraphHeadroom}"
                                  ToolTip="{local:Str Main.Status.GraphTip}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Stats.SpeedText}" Style="{StaticResource SecondaryText}"
                               Width="{DynamicResource SpeedTextWidth}" TextAlignment="Right" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular"/>
                </Grid>
            </Border>

            <!-- Sheet: modal unter der Titelleiste, wie unter macOS -->
            <Grid x:Name="SheetLayer" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed"
                  KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                <Border Background="{DynamicResource Backdrop}"/>
                <ContentControl x:Name="SheetHost" Style="{StaticResource SheetPanel}" HorizontalAlignment="Center"
                                VerticalAlignment="Top" Margin="{DynamicResource SheetMargin}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
