<UserControl x:Class="YDownloader.Sheets.ConfirmSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:YDownloader"
             Width="{DynamicResource SheetWidthSmall}">
    <StackPanel>
        <TextBlock x:Name="Heading" Style="{StaticResource SheetTitle}" TextWrapping="Wrap"/>
        <TextBlock x:Name="Message" Margin="{DynamicResource GapTop}" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{DynamicResource GapTopL}">
            <Button Content="{l:Str Common.Cancel}" Style="{StaticResource PushButton}" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="Ok" Style="{StaticResource AccentButton}" IsDefault="True" Margin="{DynamicResource GapLeft}"
                    Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
