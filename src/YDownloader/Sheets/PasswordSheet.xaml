<UserControl x:Class="YDownloader.Sheets.PasswordSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:YDownloader"
             Width="{DynamicResource SheetWidthSmall}">
    <StackPanel>
        <TextBlock x:Name="Heading" Text="{l:Str Password.Title}" Style="{StaticResource SheetTitle}" TextWrapping="Wrap"/>
        <TextBlock x:Name="Subject" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   Margin="{DynamicResource GapTopS}"/>
        <PasswordBox x:Name="PasswordInput" Margin="{DynamicResource GapTop}" PasswordChanged="Password_Changed"/>
        <TextBlock Text="{l:Str Password.Hint}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                   Margin="{DynamicResource GapTopS}"/>
        <CheckBox x:Name="RememberBox" Content="{l:Str Password.Remember}" IsChecked="True" Margin="{DynamicResource GapTop}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{DynamicResource GapTopL}">
            <Button Content="{l:Str Common.Cancel}" Style="{StaticResource PushButton}" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="Ok" Content="{l:Str Password.Go}" Style="{StaticResource AccentButton}" IsDefault="True" IsEnabled="False"
                    Margin="{DynamicResource GapLeft}" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
